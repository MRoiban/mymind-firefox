+// Firefox: right-clicking a post / card (not a link, image or selection) saves
+// that post's permalink when we can find one, otherwise the whole page.
+async function saveContextTarget(info, tab) {
+  let permalink = null;
+
+  if (info.targetElementId !== undefined) {
+    try {
+      let [injected] = await browser.scripting.executeScript({
+        target : { tabId: tab.id, frameIds: [ info.frameId ?? 0 ] },
+        func   : findPermalink,
+        args   : [ info.targetElementId ]
+      });
+
+      permalink = injected?.result ?? null;
+    }
+    catch (err) {
+      log('could not inspect the clicked element', err);
+    }
+  }
+
+  if (permalink && permalink !== tab.url) {
+    await saveObject({ url: permalink }, tab);
+  }
+  else {
+    await savePage(tab);
+  }
+}
+
+// Runs in the page. Walks up from the right-clicked element to the nearest
+// post-like container and returns its permalink.
+function findPermalink(targetElementId) {
+  const el = browser.menus.getTargetElement(targetElementId);
+
+  if (!el || !el.closest) return null;
+
+  const postPattern = /\/status\/\d+|\/watch\?v=|\/shorts\/|\/reels?\/|\/p\/[\w-]+|\/comments\/|\/posts?\//;
+
+  const href = a => (a && /^https?:/.test(a.href)) ? a.href : null;
+
+  // Reddit
+  const redditPost = el.closest('shreddit-post[permalink]');
+
+  if (redditPost) {
+    return new URL(redditPost.getAttribute('permalink'), location.href).href;
+  }
+
+  const link = el.closest('a[href]');
+
+  if (link && postPattern.test(link.href)) return href(link);
+
+  for (let node = el; node && node !== document.body && node !== document.documentElement; node = node.parentElement) {
+    // Stop once we're clearly past a single card (e.g. the whole timeline).
+    if (node.getBoundingClientRect().height > window.innerHeight * 1.5) break;
+
+    if (node.tagName === 'MAIN') break;
+
+    // Social posts link their timestamp to the post (X, Mastodon, Bluesky, Threads…)
+    const timeLink = node.querySelector('a[href] time')?.closest('a');
+
+    if (timeLink) return href(timeLink);
+
+    const postLink = [ ...node.querySelectorAll('a[href]') ].find(a => postPattern.test(a.href));
+
+    if (postLink) return href(postLink);
+  }
+
+  return null;
 }
 
