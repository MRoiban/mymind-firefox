+// Firefox: MV3 host permissions can be revoked by the user in about:addons. Without
+// access to mymind the cookie lookup fails and we'd wrongly ask them to sign in, so
+// re-request it. Must be the first await in a user-action handler to keep the
+// gesture; resolves immediately (no prompt) when access is already granted.
+function ensureHostAccess() {
+  return browser.permissions.request({ origins: [ `https://${mymind.host}/*` ] })
+    .catch(() => false);
